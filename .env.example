# CentralPay MAX Production Environment Configuration Template
# Copy this file to apps/web/.env.local and populate with your credentials

# 1. Base Application URL
NEXT_PUBLIC_APP_URL=https://centralpay-xi.vercel.app

# 2. Supabase PostgreSQL Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Admin Security & Authentication
# Note: Never commit production passwords to git!
ADMIN_EMAIL=admin@centralpay.internal
ADMIN_PASSWORD=your_secure_admin_password_here

# 4. Cryptographic Secrets
CENTRALPAY_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
WEBHOOK_SIGNING_SECRET=whsec_0123456789abcdef0123456789abcdef
